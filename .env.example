# Copy this file to .env and fill in your real MongoDB connection string.
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/loadsmart
# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loadsmart

MONGODB_URI=mongodb://127.0.0.1:27017/loadsmart
PORT=4000

# ---------- Permanent file storage — GridFS (lib/fileStorageService.js) ----------
# Every uploaded photo/KYC/POD/invoice document is stored permanently inside
# MongoDB itself (GridFS), in the SAME database MONGODB_URI points at — not
# on this server's local disk, which is not guaranteed to survive a restart
# or redeploy on most hosting platforms (this was the root cause of photos
# "disappearing after 1-2 days"). Nothing extra to provision — GridFS is
# just a set of collections in your existing MongoDB database/Atlas cluster.
#
# The name of the GridFS bucket (creates "<name>.files" / "<name>.chunks"
# collections in your database). Safe to leave at the default.
FILE_BUCKET_NAME=loadsmartFiles
# Maximum accepted upload size, in MB, enforced server-side before anything
# is written to GridFS.
FILE_MAX_SIZE_MB=10
# Reserved for deployments that want to explicitly confirm the Admin
# Portal's file-review endpoints (/api/admin/users/:userId/documents,
# /api/admin/users/:userId/photo, /api/admin/documents/:fileId/verify) are
# enabled — those routes already require a valid admin session regardless
# of this flag; it exists as an extra, explicit kill-switch some deployments
# prefer for anything that can serve KYC documents. Leave unset (or "true")
# to keep them enabled, the same behavior as before this flag existed.
ADMIN_FILE_ACCESS_ENABLED=true

# Email notification — sent to this address every time a Shipper, Broker or
# Carrier account is created. Without SMTP_* configured, the notification is
# only logged to the server console (dev mode), so nothing costs money.
NOTIFY_TO_EMAIL=singhshail144@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Email notification system (lib/emailProvider.js) ----------
# Which provider actually sends the emails lib/emailService.js renders.
# 'smtp' reuses SMTP_HOST/SMTP_USER/SMTP_PASS above. 'resend'/'sendgrid'
# call that provider's HTTP API using EMAIL_API_KEY. 'ses' is a documented
# extension point (see lib/emailProvider.js) — not wired up out of the box.
# Leaving this unset falls back to 'smtp' when SMTP is configured, else a
# 'console' dev mode that only logs emails (no external calls, no cost).
EMAIL_PROVIDER=smtp   # smtp | resend | sendgrid | ses | console
EMAIL_FROM=
EMAIL_API_KEY=
# Absolute base URL used to build "View Load"/"View Match" links in emails
# (e.g. https://app.loadsmart.in). Without it, links are relative paths —
# fine when opened from a browser already on the site, but a real
# deployment should set this.
APP_BASE_URL=
# Support address shown in every email's footer.
SUPPORT_EMAIL=
# Configurable match-score thresholds (lib/matchConfig.js) that gate the
# "Perfect/Strong/Possible Match" emails — see lib/matchingEngine.js's
# computeLoadTruckMatchScore(). Scores below MATCH_POSSIBLE_THRESHOLD never
# trigger a match email at all.
MATCH_PERFECT_THRESHOLD=90
MATCH_STRONG_THRESHOLD=75
MATCH_POSSIBLE_THRESHOLD=60

# ---------- GPS live-tracking system (lib/gpsConfig.js, lib/gpsValidation.js) ----------
# All thresholds below have sane built-in defaults (shown here) — nothing
# needs to be set for the system to work. Override only if your fleet's
# real-world conditions need different behavior.
#
# Minimum time between two accepted (stored) GPS points for the same load,
# even if the truck is moving — a hard floor under GPS_MIN_MOVEMENT_METERS,
# to keep a fast-moving truck from writing a location document every second.
GPS_MIN_INTERVAL_MS=2000
# Minimum distance (meters, great-circle) the truck must have moved since
# the last accepted point before a new point is accepted while sitting
# still (or barely past GPS_MIN_INTERVAL_MS) — filters out GPS jitter from
# a stationary truck.
GPS_MIN_MOVEMENT_METERS=15
# Accuracy (meters) at/above which a GPS fix is treated as "weak" but still
# usable (surfaced to the UI, not rejected).
GPS_WEAK_ACCURACY_METERS=100
# Accuracy (meters) at/above which a GPS fix is rejected outright as too
# unreliable to store or broadcast.
GPS_MAX_ACCURACY_METERS=2000
# How long (ms) after the last accepted GPS point before that load's
# "current location" is considered stale (driver may have lost signal,
# closed the tab, or the trip actually stopped) rather than live.
GPS_STALE_AFTER_MS=120000
# Hard ceiling on how many points a single tracking-history request can
# ever return, regardless of the caller's requested `limit` — keeps a
# route-history map view bounded even for a very long trip.
GPS_MAX_HISTORY_POINTS=1000
# Default number of history points returned when the caller doesn't pass
# `limit` explicitly.
GPS_DEFAULT_HISTORY_POINTS=300
# Maximum allowed difference (ms) between a GPS point's own device
# timestamp and the server's received time before that point is rejected
# as clock-skewed (protects against a driver device with a badly wrong
# clock silently corrupting the trip's timeline).
GPS_MAX_CLOCK_SKEW_MS=600000

# Real AI features (lib/aiService.js) — the public chatbot (POST /api/chat),
# the Admin Risk & Recommendation Copilot, the POD AI vision check, and the
# Delay Risk Narrator. ALL FOUR fail soft and stay fully functional (minus
# the AI parts) with none of these set: the chatbot falls back to its
# built-in rule-based responder, and the other three routes return a clear
# 503 "AI isn't configured" instead of an error page. Set these to turn
# them on — only 'anthropic' is actually implemented today (openai/gemini
# are reserved for a future provider addition to lib/aiService.js).
CHAT_AI_PROVIDER=anthropic   # anthropic | openai | gemini (openai/gemini not yet implemented)
ANTHROPIC_API_KEY=
# Optional — defaults to a current Claude Sonnet model in lib/aiService.js.
# Override if your account should use a different Claude model id.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- SMS notification system (lib/smsProvider.js) ----------
# Real delivery via Twilio's REST API (no SDK dependency — called with
# fetch() directly, same as the email Resend/SendGrid adapters). Without
# these set, every SMS is logged to the server console instead of sent —
# the database workflow (loads, connections, bids, etc.) is completely
# unaffected either way; only actual text-message delivery is skipped.
SMS_PROVIDER=twilio   # twilio | console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Alternative to TWILIO_FROM_NUMBER — a Messaging Service SID, if you use one.
TWILIO_MESSAGING_SERVICE_SID=
